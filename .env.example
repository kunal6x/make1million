# Node supports: node --env-file=.env server.mjs
# Default mode is a local preview; no inquiries are accepted.
HOST=127.0.0.1
PORT=3000
ACCEPT_INQUIRIES=false
# Set a real, monitored business email before enabling intake.
CONTACT_EMAIL=
# Optional HTTPS payment link belonging to the seller. No secret/API key here.
PAYMENT_URL=
# Inquiries are stored on disk; production needs durable storage and operator review.
DATA_DIR=./data
